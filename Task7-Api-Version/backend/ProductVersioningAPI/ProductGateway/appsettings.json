{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
    "ReverseProxy": {
      "Routes": {
        "products-v1-route": {
          "ClusterId": "products-cluster",
          "Match": {
            "Path": "/products/v1/{**catch-all}"
          },
          "Transforms": [
            {
              "PathPattern": "/api/v1/products/{**catch-all}"
            }
          ]
        },

        "products-v2-route": {
          "ClusterId": "products-cluster",
          "Match": {
            "Path": "/products/v2/{**catch-all}"
          },
          "Transforms": [
            {
              "PathPattern": "/api/v2/products/{**catch-all}"
            }
          ]
        }
      },

      "Clusters": {
        "products-cluster": {
          "Destinations": {
            "product-api": {
              "Address": "https://localhost:7245/"
            }
          }
        }
      }
    },
  "AllowedHosts": "*"
}
