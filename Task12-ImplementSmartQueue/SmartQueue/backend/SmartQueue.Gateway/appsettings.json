
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "smartqueue-api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "signalr-route": {
    "ClusterId": "smartqueue-api",
    "Match": {
        "Path": "/hubs/{**catch-all}"
    }
}
    },
    "Clusters": {
      "smartqueue-api": {
        "Destinations": {
          "api-destination": {
            "Address": "http://localhost:5233/"
          }
        }
      }
    }
  }
}
